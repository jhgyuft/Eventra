<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow Effect -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FFC107" />
            <size android:width="56dp" android:height="56dp" />
        </shape>
    </item>
    <!-- Inner Circle -->
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/bg_card" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>